# Copy to .env and fill in. Never commit .env.

# Postgres connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/movie_memory?schema=public"

# NextAuth
# Generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI
OPENAI_API_KEY=""
# Optional, defaults to gpt-4o-mini
OPENAI_MODEL="gpt-4o-mini"

# Optional: only needed to run the Postgres integration test (tests/integration)
# TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/movie_memory_test?schema=public"
